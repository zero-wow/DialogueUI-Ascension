                    </Frame>

                    <Frame parentKey="QuestPortrait" hidden="true" alpha="0">
                        <Size x="170" y="170"/>
                        <Anchors>
                            <Anchor point="TOP" relativePoint="TOPRIGHT" x="0" y="0"/> 
                        </Anchors>
                        <Layers>
                            <Layer level="OVERLAY">
                                <Texture parentKey="FrontTexture" setAllPoints="true"/>
                            </Layer>
                            <Layer level="OVERLAY">
                                <FontString parentKey="Name" inherits="DUIFont_Constant_10" justifyH="CENTER" justifyV="MIDDLE" spacing="2" text="Anduin Wrynn">
                                    <Size x="70"/>
                                    <Anchors>
                                        <Anchor point="CENTER" relativePoint="BOTTOM" y="42"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                        <Frames>
                            <PlayerModel parentKey="Model">
                                <Size x="78" y="78"/>
                                <Anchors>
                                    <Anchor point="CENTER" relativePoint="TOP" y="-71"/>
                                </Anchors>
                                <Layers>
                                    <Layer level="BACKGROUND">
                                        <Texture parentKey="Background" setAllPoints="true">
                                            <Color r="0" g="0" b="0"/>
                                        </Texture>
                                    </Layer>
                                </Layers>
                                <Scripts>
                                    <OnLoad>
                                        local parent = self:GetParent();
                                        if parent then
                                            self:SetFrameLevel(parent:GetFrameLevel());
                                        end
                                    </OnLoad>
                                </Scripts>
                            </PlayerModel>
                            <Frame parentKey="PortraitNameFrame">
                                <Size x="80" y="40"/>
                                <Anchors>
                                    <Anchor point="CENTER" relativePoint="CENTER"/>
                                </Anchors>
                            </Frame>
                        </Frames>
                        <Scripts>
                            <OnLoad>
                                for key, value in pairs(DUIDialogQuestPortraitMixin) do
                                    self[key] = value;
                                end
                                self.PortraitNameFrame:ClearAllPoints();
                                self.PortraitNameFrame:SetPoint("CENTER", self.Name, "CENTER");
                                self:OnLoad();
                            </OnLoad>
                            <OnHide>self:OnHide();</OnHide>
                        </Scripts>
                    </Frame>
                </Frames>
            </Frame>

            <Frame parentKey="ContentFrame">
                <Frames>
                    <Frame parentKey="ButtonHighlight" hidden="true">
                        <Size x="32" y="32"/>
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture parentKey="BackTexture" setAllPoints="true">
                                </Texture>
                            </Layer>
                            <Layer level="OVERLAY">
                                <Texture parentKey="FrontTexture">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="8" y="0"/>
                                        <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT" x="8" y="0"/>
                                    </Anchors>    
                                </Texture>
                            </Layer>
                        </Layers>
                    </Frame>

                    <Frame parentKey="RewardSelection" hidden="true">
                        <Size x="32" y="32"/>
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture parentKey="BackTexture" setAllPoints="true" alphaMode="ADD">
                                </Texture>
                            </Layer>
                            <Layer level="OVERLAY">
                                <Texture parentKey="FrontTexture" setAllPoints="true"/>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
            </Frame>

            <ScrollFrame parentKey="ScrollFrame">
