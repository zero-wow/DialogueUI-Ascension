    <Frame name="DUIQuestFrame" hidden="true" frameStrata="DIALOG" toplevel="true">
        <Size x="300" y="400"/>
        <Frames>
            <Frame parentKey="BackgroundFrame" setAllPoints="true">
                <Frames>
                    <Frame parentKey="ClipFrame" setAllPoints="true">
                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture parentKey="BackgroundDecor" hidden="true">
                                    <Size x="360" y="360"/>
                                    <Anchors>
                                        <Anchor point="RIGHT" y="-45"/>
                                    </Anchors>
                                </Texture>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
                <Scripts>
                    <OnLoad>
                        local parent = self:GetParent();
                        if parent then
                            self:SetFrameLevel(parent:GetFrameLevel());
                        end
                    </OnLoad>
                </Scripts>
            </Frame>

            <Frame parentKey="FrontFrame" frameLevel="10">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="FooterDivider" alpha="0" hidden="true">
                            <Size x="392" y="34"/>
                            <Anchors>
                                <Anchor point="CENTER" relativePoint="BOTTOM" y="96"/>
                            </Anchors>
                        </Texture>
                        <Texture parentKey="HeaderDivider" alpha="0" hidden="true">  <!--For Gossip-->
                            <Size x="392" y="34"/>
                            <Anchors>
                                <Anchor point="CENTER" relativePoint="TOP" y="-42"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Frame parentKey="Header" hidden="true">
                        <Size x="358" y="51"/>
                        <Anchors>
                            <Anchor point="TOP" relativePoint="TOP" y="-28"/>
                        </Anchors>
                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture parentKey="Portrait" alpha="1">
                                    <Size x="34" y="34"/>
                                    <Anchors>
                                        <Anchor point="CENTER" relativePoint="TOPLEFT" x="23" y="-23"/>
                                    </Anchors>
                                </Texture>
                            </Layer>
                            <Layer level="OVERLAY">
                                <Texture parentKey="Divider">
                                    <Size x="358" y="51"/>
                                    <Anchors>
                                        <Anchor point="TOP" relativePoint="TOP"/>
                                    </Anchors>
                                </Texture>
                                <FontString parentKey="Title" inherits="DUIFont_Quest_Title_18" justifyH="LEFT" justifyV="BOTTOM" text="Quest Title">
