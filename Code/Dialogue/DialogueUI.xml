    <Button name="DUIDialogOptionButtonTemplate" registerForClicks="LeftButtonUp, RightButtonUp" motionScriptsWhileDisabled="true" virtual="true">
        <Size x="256" y="20"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="Content">
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture parentKey="Icon">
                            <Size x="14" y="14"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="4" y="-4"/>
                            </Anchors>
                        </Texture>
                        <FontString parentKey="Name" inherits="DUIFont_Quest_Gossip" justifyH="LEFT" justifyV="TOP">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="20" y="-4"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad>
                for key, value in pairs(DUIDialogOptionButtonMixin) do
                    self[key] = value;
                end
                self:OnLoad();
            </OnLoad>
            <OnEnter>self:OnEnter(motion);</OnEnter>
            <OnLeave>self:OnLeave(motion);</OnLeave>
            <OnClick>self:OnClick(button, down);</OnClick>
            <OnMouseDown>self:OnMouseDown(button);</OnMouseDown>
            <OnMouseUp>self:OnMouseUp(button);</OnMouseUp>
        </Scripts>
    </Button>

