                    <Frame parentKey="ScrollChild">
                        <Size x="16" y="16"/>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>

            <Frame parentKey="InputBox" inherits="DUIDialogInputBoxTemplate" hidden="true"/>
        </Frames>
        <Scripts>
            <OnLoad>
                for key, value in pairs(DUIDialogBaseMixin) do
                    self[key] = value;
                end
                self:OnLoad();
            </OnLoad>
            <OnShow>self:OnShow();</OnShow>
            <OnHide>self:OnHide();</OnHide>
            <OnEvent>self:OnEvent(event, ...);</OnEvent>
            <OnMouseUp>self:OnMouseUp(button);</OnMouseUp>
            <OnMouseWheel>self:OnMouseWheel(delta);</OnMouseWheel>
        </Scripts>
    </Frame>

    <AnimationGroup name="DUIGenericPopupAnimationTemplate" virtual="true">
        <Alpha duration="0" order="1" change="-1"/>
        <Alpha duration="0.25" order="1" change="1"/>
        <Translation duration="0" order="1" offsetY="-32" offsetX="0"/>
        <Translation duration="0.5" order="1" offsetY="32" offsetX="0" smoothing="OUT"/>
    </AnimationGroup>

    <AnimationGroup name="DUIQuestFlyoutAnimationTemplate" virtual="true">
        <Translation duration="0" order="1" offsetX="0" offsetY="-16"/>
        <Translation duration="0.2" order="1" offsetX="0" offsetY="16" smoothing="OUT"/>
        <Animation duration="0.5" order="1"/>

        <Animation duration="1.5" order="2"/>

        <Animation duration="0.25" order="3"/>
    </AnimationGroup>
</Ui>
