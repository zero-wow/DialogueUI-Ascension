    </Frame>

    <Button name="DUIDialogItemButtonTemplate" hidden="true" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true"> <!--Display Items-->
        <Size x="174" y="36"/>
        <Frames>
            <Frame parentKey="AreaDefinitionItemBorder">
                <Size x="36" y="36"/>
                <Anchors>
                    <Anchor point="LEFT"/>
                </Anchors>
            </Frame>
        </Frames>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true">
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Icon">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="ItemBorder">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Name" inherits="DUIFont_Item" justifyH="LEFT" justifyV="MIDDLE" spacing="2">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="40"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-8"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Count" inherits="DUIFont_ItemCount" justifyH="RIGHT" justifyV="BOTTOM">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-1" y="1"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="ItemOverlay" hidden="true">
                    <Size x="36" y="36"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
				<Texture parentKey="Sheen" alphaMode="ADD" hidden="true">
					<Size x="36" y="36"/>
					<Anchors>
						<Anchor point="LEFT" x="0" y="0"/>
					</Anchors>
					<Animations>
						<AnimationGroup parentKey="AnimSheen">
							<Alpha parentKey="Delay1" change="0" duration="0.25" order="1"/>
							<Alpha change="1" duration="0.2" order="2"/>
							<Translation offsetX="140" offsetY="0" duration="0.6" order="2" smoothing="OUT"/>
							<Alpha startDelay="0.1" change="-1" duration="0.45" order="2"/>
						</AnimationGroup>
					</Animations>
				</Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                for key, value in pairs(DUIDialogItemButtonMixin) do
                    self[key] = value;
                end
                self.Icon:ClearAllPoints();
                self.Icon:SetPoint("CENTER", self.AreaDefinitionItemBorder, "CENTER");
                self.ItemBorder:ClearAllPoints();
                self.ItemBorder:SetPoint("TOPLEFT", self.AreaDefinitionItemBorder, "TOPLEFT");
                self.ItemBorder:SetPoint("BOTTOMRIGHT", self.AreaDefinitionItemBorder, "BOTTOMRIGHT");
                self.Count:ClearAllPoints();
                self.Count:SetPoint("BOTTOMRIGHT", self.Icon, "BOTTOMRIGHT", -1, 1);
                self.ItemOverlay:ClearAllPoints();
                self.ItemOverlay:SetPoint("CENTER", self.AreaDefinitionItemBorder, "CENTER");
                self:OnLoad();
            </OnLoad>
            <OnEnter>self:OnEnter(motion);</OnEnter>
            <OnLeave>self:OnLeave(motion);</OnLeave>
            <OnClick>self:OnClick(button, down);</OnClick>
        </Scripts>
    </Button>

