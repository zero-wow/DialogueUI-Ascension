                                        <Anchor point="LEFT" relativePoint="LEFT" x="53" y="2"/>
                                        <Anchor point="RIGHT" relativePoint="RIGHT" x="-8" y="2"/>
                                    </Anchors>
                                </FontString>
                                <FontString parentKey="Subtitle" inherits="DUIFont_QuestType_Left" justifyH="LEFT" justifyV="BOTTOM" hidden="false">
                                    <Anchors>
                                        <Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" x="0" y="2"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                            <Layer level="ARTWORK">
                                <Texture parentKey="TopLight" alphaMode="ADD" alpha="0.06">
                                    <Size x="358" y="34"/>
                                    <Anchors>
                                        <Anchor point="CENTER" relativePoint="CENTER" y="-2"/>
                                    </Anchors>
                                </Texture>
                            </Layer>
                        </Layers>
                        <Frames>
                            <Frame parentKey="SubtitleMouseOverFrame" hidden="true">
                                <Size x="96" y="24"/>
                                <Anchors>
                                    <Anchor point="LEFT" relativePoint="LEFT"/>
                                </Anchors>
                            </Frame>
                            <Frame parentKey="WarbandCompleteAlert" hidden="false">
                                <Size x="48" y="48"/>
                                <Anchors>
                                    <Anchor point="CENTER" relativePoint="TOPRIGHT" x="-23" y="-23"/>
                                </Anchors>
                                <HitRectInsets>
                                    <AbsInset left="8" right="8" top="8" bottom="8"/>
                                </HitRectInsets>
                                <Layers>
                                    <Layer level="ARTWORK">
                                        <Texture parentKey="Icon" alpha="1" setAllPoints="true">
                                            <Size x="96" y="96"/>
                                        </Texture>
                                    </Layer>
                                </Layers>
                                <Scripts>
                                    <OnLoad>
                                        local parent = self:GetParent();
                                        if parent then
                                            self:SetFrameLevel(parent:GetFrameLevel());
                                        end
                                    </OnLoad>
                                </Scripts>
                            </Frame>
                        </Frames>
                        <Scripts>
                            <OnLoad>
                                self.Subtitle:ClearAllPoints();
                                self.Subtitle:SetPoint("BOTTOMLEFT", self.Title, "TOPLEFT", 0, 2);
