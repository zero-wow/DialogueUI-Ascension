<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Script file="WidgetManager.lua"/>
    <Script file="Widget_ItemButton.lua"/>
    <Script file="Widget_QuestItemDisplay.lua"/>
    <Script file="Widget_QuestPopup.lua"/>
    <Script file="Widget_QuickSlot.lua"/>

    <Script file="HelpTip.lua"/>

    <Frame name="DUIQuestPopupTemplate" virtual="true">
        <Size x="536" y="88"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background">
                    <Size x="576" y="128"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
                <!-- Transparent compatibility handle for the reveal animation. -->
                <Texture parentKey="BrushMask" alpha="0">
                    <Size x="576" y="128"/>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <Texture parentKey="Highlight" hidden="true" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <FontString parentKey="Header" inherits="DUIFont_AlertHeader" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="BOTTOMLEFT" x="106" y="68"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Title" inherits="DUIFont_Quest_SubHeader" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="BOTTOMLEFT" x="106" y="28"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="QuestIcon">
                    <Size x="128" y="128"/>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="BOTTOMLEFT" x="54" y="40"/>
                    </Anchors>
                    <Animations>
                        <AnimationGroup parentKey="AnimBounce" looping="REPEAT">
                            <Scale scaleX="0.9" scaleY="0.9" duration="0.75" order="1"/>
                            <Scale scaleX="1.11" scaleY="1.11" smoothing="OUT" duration="0.25" order="2"/>
                            <Rotation degrees="5" smoothing="OUT" duration="0.25" order="2"/>
                            <Scale scaleX="0.9" scaleY="0.9" duration="0.75" order="3"/>
                            <Scale scaleX="1.11" scaleY="1.11" smoothing="OUT" duration="0.25" order="4"/>
                            <Rotation degrees="-5" smoothing="OUT" duration="0.25" order="4"/>
                        </AnimationGroup>
                    </Animations>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self.Highlight:ClearAllPoints();
                self.Highlight:SetPoint("TOPLEFT", self.Background, "TOPLEFT");
                self.Highlight:SetPoint("BOTTOMRIGHT", self.Background, "BOTTOMRIGHT");
            </OnLoad>
        </Scripts>
    </Frame>

    <Button name="DUIItemActionButtonTemplate" virtual="true">
        <Size x="64" y="64"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="ButtonText" inherits="DUIFont_Item" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="IconBorder">
                    <Size x="64" y="64"/>
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon">
                    <Size x="64" y="64"/>
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BACKGROUND">
                <Texture parentKey="TextBackground">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BACKGROUND">
                <Texture parentKey="TextHighlight" alphaMode="ADD"  hidden="true" alpha="0.4">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <Texture parentKey="BorderHighlight" alphaMode="ADD" hidden="true" alpha="0.25">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Cooldown parentKey="Cooldown" hidden="true">
                <Size x="64" y="64"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                </Anchors>
                <!-- The 3.3.5 Cooldown widget uses its built-in swipe texture. -->
            </Cooldown>
        </Frames>
        <Scripts>
            <OnLoad>
                self.Icon:ClearAllPoints();
                self.Icon:SetPoint("CENTER", self.IconBorder, "CENTER");
                self.TextHighlight:ClearAllPoints();
                self.TextHighlight:SetPoint("TOPLEFT", self.TextBackground, "TOPLEFT");
                self.TextHighlight:SetPoint("BOTTOMRIGHT", self.TextBackground, "BOTTOMRIGHT");
                self.BorderHighlight:ClearAllPoints();
                self.BorderHighlight:SetPoint("TOPLEFT", self.IconBorder, "TOPLEFT");
                self.BorderHighlight:SetPoint("BOTTOMRIGHT", self.IconBorder, "BOTTOMRIGHT");
                self.Cooldown:ClearAllPoints();
                self.Cooldown:SetPoint("TOPLEFT", self.IconBorder, "TOPLEFT");
                self.Cooldown:SetPoint("BOTTOMRIGHT", self.IconBorder, "BOTTOMRIGHT");
            </OnLoad>
        </Scripts>
    </Button>

    <Frame name="DUIHelpTipFrameTemplate" virtual="true">
        <Size x="256" y="104"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="DUIFont_Tooltip_Large" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="CENTER" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="BackgroundFrame" inherits="DUIGenericTitledFrameTemplate"/>
            <Frame parentKey="ArrowFrame">
                <Size x="16" y="16"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture parentKey="Arrow1" alpha="0">
                            <Size x="48" y="48"/>
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                            <Animations>
                                <AnimationGroup parentKey="AnimPointRight" looping="REPEAT">
                                    <Translation order="1" offsetX="-6" duration="0"/>
                                    <Alpha order="1" change="0" duration="1.0"/>
                                    <Alpha order="2" change="1" duration="0.2"/>
                                    <Alpha order="2" change="-1" duration="0.4" startDelay="1.0"/>
                                    <Translation order="2" offsetX="10" duration="1.0" smoothing="OUT"/>
                                </AnimationGroup>
                            </Animations>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="CloseButton">
                <Size x="48" y="48"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT"/>
                </Anchors>
                <HighlightTexture parentKey="HighlightTexture"/>
                <NormalTexture parentKey="NormalTexture"/>
            </Button>
            <Frame parentKey="OkayButton" hidden="true">    <!--Not a Button-->
                <Size x="32" y="16"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="ButtonText" inherits="DUIFont_Tooltip_Medium" justifyH="RIGHT" justifyV="TOP">
                            <Anchors>
                                <Anchor point="RIGHT" relativePoint="RIGHT" x="0" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>
</Ui>
